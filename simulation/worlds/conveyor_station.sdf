<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="conveyor_station">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.85 0.88 0.92 1</background>
    </scene>
    <light type="directional" name="sun">
      <pose>-1 -2 5 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.8</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.3 0.2 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="conveyor">
      <static>true</static>
      <pose>0 0 0.75 0 0 0</pose>
      <link name="belt_link">
        <collision name="belt_collision">
          <geometry>
            <box>
              <size>1.65 0.34 0.08</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>50</mu2>
                <fdir1>0 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="belt_visual">
          <geometry>
            <box>
              <size>1.65 0.34 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.12 0.45 1</ambient>
            <diffuse>0.05 0.12 0.45 1</diffuse>
          </material>
        </visual>
        <visual name="belt_frame">
          <pose>0 0 -0.08 0 0 0</pose>
          <geometry>
            <box>
              <size>1.72 0.43 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.34 0.39 1</ambient>
            <diffuse>0.3 0.34 0.39 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
        <link>belt_link</link>
        <velocity_topic>/conveyor/speed</velocity_topic>
        <odometry_publish_frequency>20</odometry_publish_frequency>
      </plugin>
    </model>
    <model name="pickup_table">
      <static>true</static>
      <pose>-0.55 -0.55 0.73 0 0 0</pose>
      <link name="table_link">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>0.38 0.36 0.12</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>0.38 0.36 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.38 0.4 1</ambient>
            <diffuse>0.35 0.38 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="lower_box">
      <pose>-0.52 0 0.83 0 0 0</pose>
      <link name="box_link">
        <inertial>
          <mass>0.25</mass>
          <inertia>
            <ixx>0.00045</ixx>
            <iyy>0.00045</iyy>
            <izz>0.0006</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.12 0.12 0.08</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.12 0.12 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.94 0.39 0.13 1</ambient>
            <diffuse>0.94 0.39 0.13 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
        <topic>/simulation/lower_box/pose</topic>
      </plugin>
    </model>
    <model name="upper_box">
      <pose>-0.55 -0.55 0.82 0 0 0</pose>
      <link name="box_link">
        <inertial>
          <mass>0.10</mass>
          <inertia>
            <ixx>0.00012</ixx>
            <iyy>0.00012</iyy>
            <izz>0.00013</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.09 0.09 0.06</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.09 0.09 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.16 0.72 0.46 1</ambient>
            <diffuse>0.16 0.72 0.46 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
        <topic>/simulation/upper_box/pose</topic>
      </plugin>
    </model>
    <model name="gantry">
      <pose>-0.55 -0.55 1.03 0 0 0</pose>
      <self_collide>false</self_collide>
      <link name="base">
        <inertial>
          <mass>50</mass>
          <inertia>
            <ixx>1</ixx>
            <iyy>1</iyy>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="beam">
          <pose>0 0 0.16 0 0 0</pose>
          <geometry>
            <box>
              <size>1.75 0.07 0.07</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.33 1</ambient>
            <diffuse>0.3 0.3 0.33 1</diffuse>
          </material>
        </visual>
        <gravity>false</gravity>
      </link>
      <joint name="base_fixed" type="fixed">
        <parent>world</parent>
        <child>base</child>
      </joint>
      <link name="x_carriage">
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.03</ixx>
            <iyy>0.03</iyy>
            <izz>0.03</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.12 0.15 0.09</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.73 0.77 1</ambient>
            <diffuse>0.7 0.73 0.77 1</diffuse>
          </material>
        </visual>
        <gravity>false</gravity>
      </link>
      <joint name="x_joint" type="prismatic">
        <parent>base</parent>
        <child>x_carriage</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <lower>-0.10</lower>
            <upper>1.20</upper>
            <effort>1000</effort>
            <velocity>0.8</velocity>
          </limit>
        </axis>
      </joint>
      <link name="y_carriage">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.02</ixx>
            <iyy>0.02</iyy>
            <izz>0.02</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.67 0.7 0.73 1</ambient>
            <diffuse>0.67 0.7 0.73 1</diffuse>
          </material>
        </visual>
        <gravity>false</gravity>
      </link>
      <joint name="y_joint" type="prismatic">
        <parent>x_carriage</parent>
        <child>y_carriage</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-0.05</lower>
            <upper>0.65</upper>
            <effort>1000</effort>
            <velocity>0.8</velocity>
          </limit>
        </axis>
      </joint>
      <link name="z_carriage">
        <inertial>
          <mass>0.7</mass>
          <inertia>
            <ixx>0.005</ixx>
            <iyy>0.005</iyy>
            <izz>0.005</izz>
          </inertia>
        </inertial>
        <gravity>false</gravity>
        <visual name="vgc10_body_visual">
          <pose>0 0 -0.119 0 0 0</pose>
          <geometry>
            <box>
              <size>0.101 0.100 0.100</size>
            </box>
          </geometry>
          <material>
            <ambient>0.17 0.20 0.23 1</ambient>
            <diffuse>0.17 0.20 0.23 1</diffuse>
          </material>
        </visual>
        <visual name="vgc10_cup_b1_visual">
          <pose>-0.025000 -0.025000 -0.175 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.01500</radius>
              <length>0.0120</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.12 0.12 0.13 1</ambient>
            <diffuse>0.12 0.12 0.13 1</diffuse>
          </material>
        </visual>
        <visual name="vgc10_cup_a1_visual">
          <pose>-0.025000 0.025000 -0.175 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.01500</radius>
              <length>0.0120</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.06 0.06 0.065 1</ambient>
            <diffuse>0.06 0.06 0.065 1</diffuse>
          </material>
        </visual>
        <visual name="vgc10_cup_b2_visual">
          <pose>0.025000 -0.025000 -0.175 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.01500</radius>
              <length>0.0120</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.12 0.12 0.13 1</ambient>
            <diffuse>0.12 0.12 0.13 1</diffuse>
          </material>
        </visual>
        <visual name="vgc10_cup_a2_visual">
          <pose>0.025000 0.025000 -0.175 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.01500</radius>
              <length>0.0120</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.06 0.06 0.065 1</ambient>
            <diffuse>0.06 0.06 0.065 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="z_joint" type="prismatic">
        <parent>y_carriage</parent>
        <child>z_carriage</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-0.03</lower>
            <upper>0.45</upper>
            <effort>1000</effort>
            <velocity>0.6</velocity>
          </limit>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>x_joint</joint_name>
        <topic>/gantry/x_cmd</topic>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>0.6</cmd_max>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>y_joint</joint_name>
        <topic>/gantry/y_cmd</topic>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>0.6</cmd_max>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>z_joint</joint_name>
        <topic>/gantry/z_cmd</topic>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>0.5</cmd_max>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <joint_name>x_joint</joint_name>
        <joint_name>y_joint</joint_name>
        <joint_name>z_joint</joint_name>
        <topic>/gantry/joint_state</topic>
        <update_rate>50</update_rate>
      </plugin>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>z_carriage</parent_link>
        <child_model>upper_box</child_model>
        <child_link>box_link</child_link>
        <initial_attach>true</initial_attach>
        <attach_topic>/gripper/attach</attach_topic>
        <detach_topic>/gripper/detach</detach_topic>
        <output_topic>/gripper/attached_state</output_topic>
      </plugin>
    </model>
    <model name="external_camera">
      <static>true</static>
      <pose>-0.12 -0.25 2.20 0 0 0</pose>
      <link name="camera_link">
        <sensor name="rgb" type="camera">
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <topic>/station/camera/image</topic>
          <pose>0 0 0 0 1.57079632679 0</pose>
          <camera>
            <horizontal_fov>1.48</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.10</near>
              <far>8.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>