{
  "name": "vla-mujoco (GPU, NVIDIA)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "containerEnv": {
    "MUJOCO_GL": "egl",
    "PYTHONUNBUFFERED": "1",
    "TORCH_VARIANT": "cuda",
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,graphics,display"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "ms-vscode.makefile-tools",
        "github.vscode-github-actions",
        "ms-iot.vscode-ros",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/.ruff_cache": true
        }
      }
    }
  },
  "runArgs": [
    "--gpus=all",
    "--shm-size=8g"
  ],
  "hostRequirements": {
    "gpu": "optional"
  },
  "initializeCommand": "bash .devcontainer/init-host.sh",
  "mounts": [
    "source=${localEnv:HOME}/.claude-${localEnv:VLA_DEV_PROFILE:vla_dev},target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}/.claude-${localEnv:VLA_DEV_PROFILE:vla_dev}.json,target=/home/vscode/.claude.json,type=bind",
    "source=${localEnv:HOME}/.codex-${localEnv:VLA_DEV_PROFILE:vla_dev},target=/home/vscode/.codex,type=bind"
  ],
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  }
}
