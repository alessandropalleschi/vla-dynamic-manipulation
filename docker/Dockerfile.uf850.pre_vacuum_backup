# Build baseline image first: docker compose build
FROM conveyor-belief-vla:jazzy
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    git python3-colcon-common-extensions python3-rosdep \
    ros-jazzy-xacro ros-jazzy-robot-state-publisher \
    ros-jazzy-gz-ros2-control ros-jazzy-controller-manager \
    ros-jazzy-joint-state-broadcaster ros-jazzy-joint-trajectory-controller \
    ros-jazzy-control-msgs ros-jazzy-ros2-control \
    && rm -rf /var/lib/apt/lists/*
RUN source /opt/ros/jazzy/setup.bash && \
    ros2 pkg prefix gz_ros2_control && \
    ros2 pkg prefix xacro && \
    /usr/bin/python3 -c 'from control_msgs.action import FollowJointTrajectory; print("UF850 dependencies OK")'
WORKDIR /workspace
